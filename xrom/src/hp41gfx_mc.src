        .NAME   "GBOX"
(GBOX)  C=0     ALL
        LDI     002
        RCR     11
        LDI     000
        RCR     11
        LDI     042             ; B
        B=C     ALL             ; NCGOREL uses C
        NCGOREL (CMD4)

        .NAME   "GFBOX"
(GFBOX) C=0     ALL
        LDI     002
        RCR     11
        LDI     046             ; F
        RCR     11
        LDI     042             ; B
        B=C     ALL             ; NCGOREL uses C
        NCGOREL (CMD4)

        .NAME   "GCIRC"
(GCIRC) C=0     ALL
        LDI     001
        RCR     11
        LDI     000
        RCR     11
        LDI     04F             ; O
        B=C     ALL             ; NCGOREL uses C
        NCGOREL (CMD4)

        .NAME   "GFCIRC"
(GFCIRC) C=0    ALL
        LDI     001
        RCR     11
        LDI     046             ; F
        RCR     11
        LDI     04F             ; O
        B=C     ALL             ; NCGOREL uses C
