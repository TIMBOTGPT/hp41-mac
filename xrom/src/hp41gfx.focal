; HP41GFX user-code XROM, v0 (protocol v0, docs/graphics-protocol.md).
; The FAT follows the order of the global labels below. Add new functions at
; the end only: reordering renumbers XROM 8,nn and breaks keyed programs.
; Assembled by tools/build_xrom.py with focalcod and asmnut. In the default
; build 18 of these functions are replaced in the FAT by the microcode
; versions in hp41gfx_mc.src, which send the same bytes.
;
; Arguments follow keying order: x ENTER y GDRAW puts x in Y and y in X.
; Every function except GRAPH expects GRAPH to have selected the peripheral.
; ALPHA is used as the output buffer and is overwritten.
; Functions leave the display format at FIX 4 with flag 29 set (the HP-41
; default); user code cannot cheaply save and restore the user's format.
;
; GRAPH    find HP41GFX on the loop, select it, reset, clear screen 0
; GCLEAR   X: colour index           clear the target screen
; GCOLOR   X: colour index           pen colour
; GTARG    X: screen                 drawing target
; GSHOW    X: screen                 displayed screen
; GMOVE    Y: x  X: y                move the pen
; GDRAW    Y: x  X: y                line from the pen
; GPLOT    Y: x  X: y                one pixel in the pen colour
; GSCALE   T: xmin Z: xmax Y: ymin X: ymax   user units for GMOVE GDRAW GPLOT
; GPIXEL   none                      back to pixel coordinates
; PSET     Z: x  Y: y  X: index      write one pixel (pixel coordinates)
; PGET     Y: x  X: y                read one pixel: index returned in X (stack lifts)
; GBOX     Y: x  X: y                box outline from the pen to x y
; GFBOX    Y: x  X: y                filled box from the pen to x y
; GCIRC    X: radius                 circle outline centred on the pen
; GFCIRC   X: radius                 filled circle centred on the pen
; GTEXT    ALPHA: text (up to 22)    text at the pen in the pen colour; T is lost
; GPAL     T: index Z: r Y: g X: b   set a palette entry of the target screen
; GNEXT    none                      show the next screen
; GIMAGE   ALPHA: name  X: id        load image NAME into asset slot id; T is lost
; GSPRAY   Z: id  Y: x  X: y         place asset id with its top left at x y
; GSAVE    ALPHA: name               save the target screen as NAME; T is lost
; GLOAD    ALPHA: name               load screen NAME into the target; T is lost
; GAXES    Y: x tick  X: y tick      axes through the origin, ticks every x, y (0 = none)
; GGRID    Y: dx  X: dy              grid lines every dx, dy (0 = none in that direction)
; GVERT    Y: x  X: y                add a polygon vertex
; GPFILL   none                      fill and outline the polygon, then clear it
; GPOLY    none                      outline the closed polygon, then clear it
; GBYTES   Y: first register  X: count   send Rr.. (0-255 each) as a block's bytes
;          and LF (microcode only; this FOCAL stub stops with NEEDS MCODE)
 LBL "GRAPH"
 "HP41GFX"
 FINDID
 X=0?
 GTO 99
 SELECT
 RDN
 "GI:C 0"
 OUTA
 GTO 91
 LBL 99
 "NO HP41GFX"
 AVIEW
 STOP
 RTN
 LBL "GCLEAR"
 "C "
 GTO 81
 LBL "GCOLOR"
 "K "
 GTO 81
 LBL "GTARG"
 "T "
 GTO 81
 LBL "GSHOW"
 "S "
 LBL 81
 XEQ 90
 ARCL X
 OUTA
 GTO 91
 LBL "GMOVE"
 "M "
 GTO 80
 LBL "GDRAW"
 "D "
 GTO 80
 LBL "GPLOT"
 "P "
 LBL 80
 FIX 4
 ARCL Y
 "` "
 ARCL X
 OUTA
 RTN
 LBL "GSCALE"
 FIX 4
 "SX "
 ARCL T
 "` "
 ARCL Z
 OUTA
 "SY "
 ARCL Y
 "` "
 ARCL X
 OUTA
 RTN
 LBL "GPIXEL"
 "SP"
 OUTA
 RTN
 LBL "PSET"
 XEQ 90
 "W "
 ARCL Z
 "` "
 ARCL Y
 "` "
 ARCL X
 OUTA
 GTO 91
 LBL "PGET"
 XEQ 90
 "R "
 ARCL Y
 "` "
 ARCL X
 OUTA
 INA
 ANUM
 GTO 91
 LBL "GBOX"
 "B "
 GTO 80
 LBL "GFBOX"
 "BF "
 GTO 80
 LBL "GCIRC"
 "O "
 GTO 82
 LBL "GFCIRC"
 "OF "
 LBL 82
 FIX 4
 ARCL X
 OUTA
 RTN
 LBL "GTEXT"
 "`L "
 -2
 GTO 83
 LBL "GPAL"
 XEQ 90
 "KP "
 ARCL T
 "` "
 ARCL Z
 "` "
 ARCL Y
 "` "
 ARCL X
 OUTA
 GTO 91
 LBL "GNEXT"
 "SN"
 OUTA
 RTN
 LBL "GIMAGE"
 "`IL "
 -3
 AROT
 RDN
 XEQ 90
 "` "
 ARCL X
 OUTA
 GTO 91
 LBL "GSPRAY"
 XEQ 90
 "IP "
 ARCL Z
 FIX 4
 "` "
 ARCL Y
 "` "
 ARCL X
 OUTA
 GTO 91
 LBL "GSAVE"
 "`VS "
 -3
 GTO 83
 LBL "GLOAD"
 "`VL "
 -3
 LBL 83
 AROT
 RDN
 OUTA
 RTN
 LBL "GAXES"
 "AX "
 GTO 80
 LBL "GGRID"
 "GR "
 GTO 80
 LBL "GVERT"
 "PV "
 GTO 80
 LBL "GPFILL"
 "PF"
 OUTA
 RTN
 LBL "GPOLY"
 "PO"
 OUTA
 RTN
 LBL "GBYTES"
 "NEEDS MCODE"
 AVIEW
 STOP
 RTN
 LBL 90
 FIX 0
 CF 29
 RTN
 LBL 91
 FIX 4
 SF 29
 RTN
 END
